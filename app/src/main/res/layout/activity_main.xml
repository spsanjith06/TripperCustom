<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HUNTER 350 COCKPIT"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next-Gen Tripper Pod Bridge"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <!-- CONNECTION STATUS CARD -->
        <LinearLayout
            android:id="@+id/cardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#131926"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/tvStatusEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡"
                android:textSize="36sp"
                android:textColor="#FFA000" />

            <TextView
                android:id="@+id/tvStatusTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISCONNECTED"
                android:textColor="#EF4444"
                android:textSize="17sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvStatusSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turn on Hunter 350 ignition key"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:gravity="center"
                android:layout_marginTop="4dp" />

            <!-- LIVE TELEMETRY FEED -->
            <TextView
                android:id="@+id/tvLiveTelemetry"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ready for Google Maps navigation"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#0A0E17"
                android:padding="10dp"
                android:gravity="center"
                android:layout_marginTop="14dp" />
        </LinearLayout>

        <!-- MAIN ACTION BUTTON -->
        <Button
            android:id="@+id/btnConnectToggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CONNECT TRIPPER POD"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnNotifPermission"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="ENABLE NOTIFICATION ACCESS"
            android:backgroundTint="#1E293B"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp" />

        <!-- DISCOVERED DEVICES SECTION -->
        <TextView
            android:id="@+id/tvDeviceListHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NEARBY BIKE PODS (TAP TO CONNECT)"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:id="@+id/layoutDeviceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp">
            <!-- Dynamically populated -->
        </LinearLayout>

        <!-- PREFERENCES SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PREFERENCES &amp; FEATURES"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#131926"
            android:padding="16dp"
            android:layout_marginTop="8dp">

            <Switch
                android:id="@+id/swNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Google Maps Turn Navigation"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:checked="true"
                android:paddingBottom="12dp" />

            <Switch
                android:id="@+id/swCalls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Incoming Caller ID on Pod"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:checked="true"
                android:paddingBottom="12dp" />

            <Switch
                android:id="@+id/swMusic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Spotify / Music Title Popup"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:checked="true"
                android:paddingBottom="12dp" />

            <Switch
                android:id="@+id/swBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Low Battery Warning on Pod"
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:checked="true" />
        </LinearLayout>

        <!-- GARAGE TEST SUITE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GARAGE TEST SUITE (TEST WITHOUT RIDING)"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="24dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnTestTurn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Test 250m Turn"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTestRoundabout"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Test Roundabout"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTestCaller"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Test Caller ID"
                android:backgroundTint="#1E293B"
                android:textColor="#EF4444"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnTestMusic"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:text="Test Song Title"
                android:backgroundTint="#1E293B"
                android:textColor="#A855F7"
                android:textSize="11sp" />
        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="30dp" />

    </LinearLayout>
</ScrollView>
